# Discord bot token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# The master server's status JSON endpoint, e.g. http://155.93.192.127:10208/status.json
STATUS_URL=

# Optional. Any server can instead run /setup once the bot's in it -- that's
# the recommended path now (see README.md). This only exists to seed the
# very first deployment's channel automatically on the first run after
# upgrading, so it doesn't need /setup re-run for a channel that was
# already configured via the old single-channel CHANNEL_ID model.
CHANNEL_ID=

# How often to refresh the embed, in seconds (Discord message edits are not rate-limited as
# tightly as channel/role renames, but don't go below ~15s)
POLL_INTERVAL_SECONDS=60

# Where to remember the embed's message ID between bot restarts, so it keeps editing the
# same message instead of posting a new one every time
STATE_FILE=./state.json
