# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config \
        libgl1-mesa-dev libglu1-mesa-dev \
        libsdl2-mixer-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -S . -B build-linux \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    && cmake --build build-linux \
        --target BaboMasterServer \
        -j"$(nproc)"

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/build-linux/BaboMasterServer /app/BaboMasterServer
COPY packaging/master-bootstrap.sql /app/master-bootstrap.sql
COPY packaging/web-bootstrap.sql /app/web-bootstrap.sql

WORKDIR /app

# Initialize databases if not already present (supports volume mounts).
RUN printf '#!/bin/sh\nset -e\n\
if [ ! -s /app/master.db ]; then sqlite3 /app/master.db < /app/master-bootstrap.sql; fi\n\
if [ ! -s /app/web.db ]; then sqlite3 /app/web.db < /app/web-bootstrap.sql; fi\n\
exec /app/BaboMasterServer\n' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

EXPOSE 10207/tcp

ENTRYPOINT ["/app/entrypoint.sh"]
